# Template. Copy this file to .env and fill in real values there.
#   Windows:    copy .env.example .env
#   Mac/Linux:  cp .env.example .env
#
# .env is listed in .gitignore and must never be committed. This file is
# committed on purpose, so it holds placeholders only - never a real key.

# Your model provider's key. Paste it after the = sign, no quotes, no spaces.
API_KEY=paste-here

# Identifies you to the SEC EDGAR API, which rejects requests without it.
SEC_USER_AGENT="Jeenay Dedhia dedhiaj@purdue.edu"
